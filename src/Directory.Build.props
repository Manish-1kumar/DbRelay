<Project>

  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <TargetFrameworks>$(DbRelayLibraryTargetFrameworks)</TargetFrameworks>
    <AnalysisMode>Recommended</AnalysisMode>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>true</IsPackable>
    <EnablePackageValidation>true</EnablePackageValidation>

    <!-- Package metadata -->
    <Authors>DbRelay contributors</Authors>
    <Copyright>Copyright (c) DbRelay contributors</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>outbox;transactional-outbox;dapper;ado.net;postgresql;sqlserver;messaging;reliability</PackageTags>
    <!-- Repository URL is supplied at release time (-p:DbRelayRepositoryUrl=...); see RELEASE_CHECKLIST.md. -->
    <PackageProjectUrl Condition="'$(DbRelayRepositoryUrl)' != ''">$(DbRelayRepositoryUrl)</PackageProjectUrl>
    <RepositoryUrl Condition="'$(DbRelayRepositoryUrl)' != ''">$(DbRelayRepositoryUrl)</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)../README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
