<Project>

  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <TargetFrameworks>$(DbRelayLibraryTargetFrameworks)</TargetFrameworks>
    <AnalysisMode>Recommended</AnalysisMode>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>true</IsPackable>
    <EnablePackageValidation>true</EnablePackageValidation>
    <!--
      Packages already on nuget.org are compared with their last release, so `dotnet pack` fails on an unintended breaking
      change. Pre-1.0 an intended break is allowed: suppress that diagnostic deliberately and record it in the CHANGELOG.
      DbRelay.SqlServer has no published baseline before 0.2.0.
    -->
    <PackageValidationBaselineVersion Condition="'$(MSBuildProjectName)' != 'DbRelay.SqlServer' and '$(MSBuildProjectName)' != 'DbRelay.Oracle' and '$(MSBuildProjectName)' != 'DbRelay.MySql'">0.1.0</PackageValidationBaselineVersion>

    <!-- Package metadata -->
    <Authors>DbRelay contributors</Authors>
    <Copyright>Copyright (c) DbRelay contributors</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>outbox;transactional-outbox;dapper;ado.net;postgresql;sqlserver;messaging;reliability</PackageTags>
    <!-- Override with -p:DbRelayRepositoryUrl=... if the repository moves (for example to an organisation). -->
    <DbRelayRepositoryUrl Condition="'$(DbRelayRepositoryUrl)' == ''">https://github.com/Manish-1kumar/DbRelay</DbRelayRepositoryUrl>
    <PackageProjectUrl>$(DbRelayRepositoryUrl)</PackageProjectUrl>
    <RepositoryUrl>$(DbRelayRepositoryUrl)</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <!-- A package-specific README: nuget.org cannot resolve the repository README's relative links. -->
    <None Include="$(MSBuildThisFileDirectory)PACKAGE_README.md" Pack="true" PackagePath="\README.md" Visible="false" />
  </ItemGroup>

</Project>
