<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>DbRelay.MySql</RootNamespace>
    <Description>MySQL and MariaDB storage provider for DbRelay (MySqlConnector): transactional outbox inserts in the caller's MySqlTransaction, FOR UPDATE SKIP LOCKED claiming with leases and lock tokens, retention cleanup and explicit, idempotent schema creation. MySQL 8.0+ (including Amazon RDS and Aurora MySQL 3) and MariaDB 10.11+.</Description>
    <PackageTags>$(PackageTags);mysql;mariadb;aurora</PackageTags>
    <!-- First published in 0.3.0, so there is no earlier package to validate its API against. -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DbRelay\DbRelay.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MySqlConnector" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Scripts\001_create_outbox.sql" LogicalName="DbRelay.MySql.Scripts.001_create_outbox.sql" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DbRelay.MySql.Tests" />
  </ItemGroup>

</Project>
