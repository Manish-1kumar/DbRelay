<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>DbRelay.SqlServer</RootNamespace>
    <Description>SQL Server storage provider for DbRelay (Microsoft.Data.SqlClient): transactional outbox inserts in the caller's SqlTransaction, UPDLOCK/READPAST/ROWLOCK claiming with leases and lock tokens, retention cleanup and explicit, idempotent schema creation. Works with or without READ_COMMITTED_SNAPSHOT. Tested on SQL Server 2019, 2022 and 2025.</Description>
    <!-- First packed in 0.2.0 (project brief §15), so there is no earlier package to validate its API against. -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DbRelay\DbRelay.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Scripts\001_create_outbox.sql" LogicalName="DbRelay.SqlServer.Scripts.001_create_outbox.sql" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DbRelay.SqlServer.Tests" />
  </ItemGroup>

</Project>
