<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    The Web SDK is used for two reasons: IHttpClientFactory (Microsoft.Extensions.Http) is part of the ASP.NET Core shared
    framework, so no extra package is needed, and the sample hosts its own in-process webhook receiver at /webhook.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>CustomHandler.Sample</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DbRelay.PostgreSql\DbRelay.PostgreSql.csproj" />
  </ItemGroup>

</Project>
