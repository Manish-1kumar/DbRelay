<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>DbRelay.IntegrationTests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DbRelay.PostgreSql\DbRelay.PostgreSql.csproj" />
    <!-- Built for the same target framework so the crash tests can start it with 'dotnet <dll>'; not referenced as an assembly. -->
    <ProjectReference Include="..\DbRelay.CrashWorker\DbRelay.CrashWorker.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Dapper" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Testcontainers.PostgreSql" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>CrashWorkerPath</_Parameter1>
      <_Parameter2>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\DbRelay.CrashWorker\bin\$(Configuration)\$(TargetFramework)\DbRelay.CrashWorker.dll'))</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <!-- K13: per-test schema names and the stale-schema sweep. -->
    <Compile Include="..\Shared\TestSchemaNames.cs" Link="Shared\TestSchemaNames.cs" />
  </ItemGroup>

</Project>
