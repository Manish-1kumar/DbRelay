root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,props,targets,csproj,slnx,xml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
csharp_style_namespace_declarations = file_scoped:warning
csharp_using_directive_placement = outside_namespace
dotnet_sort_system_directives_first = true
csharp_style_var_for_built_in_types = true
csharp_style_var_when_type_is_apparent = true
csharp_style_var_elsewhere = true
csharp_prefer_braces = true:warning
dotnet_style_readonly_field = true:warning
dotnet_style_qualification_for_field = false
csharp_style_expression_bodied_methods = when_on_single_line

# Library code must not capture the synchronization context.
dotnet_diagnostic.CA2007.severity = warning
# Prefer LoggerMessage delegates (we use the source generator).
dotnet_diagnostic.CA1848.severity = warning
# Catching general exceptions is intentional at loop/handler boundaries; each site is justified in code.
dotnet_diagnostic.CA1031.severity = none
# Public API types in DbRelay.Abstractions intentionally use the DbRelay namespace.
dotnet_diagnostic.CA1716.severity = none

[tests/**.cs]
dotnet_diagnostic.CA2007.severity = none
dotnet_diagnostic.CA1848.severity = none
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.CA1861.severity = none
dotnet_diagnostic.CA2000.severity = none
dotnet_diagnostic.CA1515.severity = none
dotnet_diagnostic.CA1001.severity = none

[{samples,benchmarks}/**.cs]
dotnet_diagnostic.CA2007.severity = none
dotnet_diagnostic.CA1848.severity = none
dotnet_diagnostic.CA1515.severity = none
dotnet_diagnostic.CA1812.severity = none
